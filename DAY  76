class Solution(object):
    def sortableIntegers(self, nums):
        n = len(nums)
        s = sorted(nums)
        ans = 0

        for k in range(1, n + 1):
            if n % k != 0:
                continue

            valid = True

            for start in range(0, n, k):
                block = nums[start:start + k]
                target = s[start:start + k]

                # Build KMP prefix array
                pi = [0] * k
                j = 0

                for i in range(1, k):
                    while j > 0 and target[i] != target[j]:
                        j = pi[j - 1]

                    if target[i] == target[j]:
                        j += 1

                    pi[i] = j

                # Search target in two copies of block
                j = 0
                found = False

                for i in range(2 * k - 1):
                    x = block[i % k]

                    while j > 0 and x != target[j]:
                        j = pi[j - 1]

                    if x == target[j]:
                        j += 1

                    if j == k:
                        found = True
                        break

                if not found:
                    valid = False
                    break

            if valid:
                ans += k

        return ans
