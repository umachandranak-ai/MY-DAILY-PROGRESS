CREATE TABLE employee_sales (
    employee_id INT,
    employee_name VARCHAR(50),
    month_name VARCHAR(20),
    sales INT
);

INSERT INTO employee_sales VALUES
(1, 'Arun', 'January', 50000),
(2, 'Bala', 'January', 70000),
(3, 'Charan', 'January', 60000),
(4, 'David', 'January', 70000),
(5, 'Ezhil', 'January', 40000),
(6, 'Arun', 'February', 80000),
(7, 'Bala', 'February', 60000),
(8, 'Charan', 'February', 80000),
(9, 'David', 'February', 50000),
(10, 'Ezhil', 'February', 60000);

SELECT
    employee_id,
    employee_name,
    month_name,
    sales,
    RANK() OVER (
        PARTITION BY month_name
        ORDER BY sales DESC
    ) AS sales_rank
FROM employee_sales
ORDER BY month_name, sales_rank;

