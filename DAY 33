(4, 'Deepak', 65),
(5, 'Ezhil', 90),
(6, 'Fathima', 80),
(7, 'Gokul', 70),
(8, 'Hari', 60);

SELECT
    employee_id,
    employee_name,
    performance_score,
    NTILE(4) OVER (ORDER BY performance_score DESC) AS performance_group
FROM employees;

