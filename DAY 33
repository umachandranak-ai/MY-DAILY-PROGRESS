CREATE TABLE EmployeeSales (
    employee_id INT,
    employee_name VARCHAR(50),
    sale_month DATE,
    sales DECIMAL(10,2)
);

INSERT INTO EmployeeSales VALUES
(101, 'Arun', '2026-08-01', 45000),
(101, 'Arun', '2026-09-01', 52000),
(102, 'Bala', '2026-08-01', 38000),
(102, 'Bala', '2026-09-01', 35000),
(103, 'Chandru', '2026-08-01', 60000),
(103, 'Chandru', '2026-09-01', 75000);

SELECT
    employee_id,
    employee_name,
    MAX(CASE
        WHEN YEAR(sale_month) = 2026
        AND MONTH(sale_month) = 9
        THEN sales
    END) AS current_month_sales,

    MAX(CASE
        WHEN YEAR(sale_month) = 2026
        AND MONTH(sale_month) = 8
        THEN sales
    END) AS previous_month_sales,

    MAX(CASE
        WHEN YEAR(sale_month) = 2026
        AND MONTH(sale_month) = 9
        THEN sales
    END)
    -
    MAX(CASE
        WHEN YEAR(sale_month) = 2026
        AND MONTH(sale_month) = 8
        THEN sales
    END) AS difference

FROM EmployeeSales
GROUP BY employee_id, employee_name;
